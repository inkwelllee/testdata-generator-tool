{
	"name": "gentool",
	"private": true,
	"version": "0.6.4.28",
	"type": "module",
	"scripts": {
		"format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
		"dev": "vite",
		"build": "vite build",
		"build:copy": "vite build && npm run copy:ui",
		"copy:ui": "node scripts/copy-to-ui.js",
		"copy:ui:win": "scripts\\copy-to-ui.bat",
		"copy:ui:unix": "bash scripts/copy-to-ui.sh",
		"build:prod": "vite build && npm run copy:ui",
		"build:win": "vite build && npm run copy:ui:win",
		"build:unix": "vite build && npm run copy:ui:unix",
		"preview": "vite preview"
	},
	"dependencies": {
		"@vicons/ionicons5": "^0.13.0",
		"@vueuse/core": "^11.3.0",
		"axios": "^1.7.9",
		"moment": "^2.30.1",
		"naive-ui": "^2.40.1",
		"vue": "^3.5.13",
		"vue-clipboard2": "^0.3.3",
		"vue-router": "4"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.2.1",
		"vite": "^6.0.1"
	}
}
